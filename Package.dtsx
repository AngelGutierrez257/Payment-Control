            <SQLTask:SqlTaskData
              SQLTask:Connection="{5CFB790F-BB7A-4A4C-A531-B99F19146910}"
              SQLTask:SqlStatementSource="SELECT [Data de pagamento]&#xA;      ,[Montante]&#xA;      ,[Estado Pagamento]&#xA;      ,[UltimaActualizacao]&#xA;      ,[Nome Entidade]&#xA;      ,[Tipo Entidade]&#xA;      ,[Tipo Fornecimento]&#xA;      ,[Banco de Pagamento]&#xA;      ,[Empresa]&#xA;  FROM [Gestao Financeira].[dbo].[Pagamentos_em_Atraso]&#xA;order by [Data de pagamento]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
